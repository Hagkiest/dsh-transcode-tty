root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown hard line break.
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
# YAML forbids tabs for indentation.
indent_style = space

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.sh]
indent_style = tab
