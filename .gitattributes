# Normalize line endings so a checkout behaves the same on every platform.
* text=auto eol=lf

# Shell scripts must keep LF even on Windows, or they fail to run under sh.
*.sh text eol=lf

# PowerShell scripts keep CRLF; Windows PowerShell 5.1 handles LF poorly in
# some hosts, and this is the platform the script targets.
*.ps1 text eol=crlf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated and installed content that must not be diffed.
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
